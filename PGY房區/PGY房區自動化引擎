OUTPUT_COLOR_RGB = {
    'pca': (0.988, 0.839, 0.408),
    'clinic': (0.902, 0.722, 0.686),
    'ward_eval': (1, 0.655, 0.4),
    'danshui': (0.812, 0.886, 0.953),
    'unassigned': (1, 0, 0),   # 程式排不出來，需要手動處理
    # 'normal' 不特別上色；'raw' 用原始顏色，見 build_output_spreadsheet
}

day_to_weekday = {r['day']: r['weekday'] for r in pgy_daily_rows}
day_to_remarks = {r['day']: r['remarks'] for r in pgy_daily_rows}


def build_output_spreadsheet():
    year, month = int(TARGET_TAB[:4]), int(TARGET_TAB[4:])
    pgy_names_ordered = list(pgy_info.keys())

    new_ss = sheets_service.spreadsheets().create(body={
        "properties": {"title": f"{TARGET_TAB} PGY房區表(自動產生)"},
        "sheets": [{"properties": {"title": TARGET_TAB}}]
    }).execute()
    spreadsheet_id = new_ss['spreadsheetId']
    sheet_id = new_ss['sheets'][0]['properties']['sheetId']

    def text_cell(value):
        return {"userEnteredValue": {"stringValue": value}}

    def colored_cell(value, rgb):
        c = {"userEnteredValue": {"stringValue": value}}
        if rgb is not None:
            r, g, b = rgb
            c["userEnteredFormat"] = {"backgroundColor": {"red": r, "green": g, "blue": b}}
        return c

    def header_row(col_b_label, value_func):
        row = [text_cell(""), text_cell(col_b_label)]
        row += [text_cell(value_func(n)) for n in pgy_names_ordered]
        row.append(text_cell(""))
        return {"values": row}

    row1 = [text_cell(f"{month}月 PGY 房區(自動產生)"), text_cell("")]
    row1 += [text_cell(pgy_info[n]['level']) for n in pgy_names_ordered]
    row1.append(text_cell("備註"))

    rows = [
        {"values": row1},
        header_row("", lambda n: pgy_info[n]['empid']),
        header_row("", lambda n: n),
        header_row("導師(上)", lambda n: pgy_info[n]['mentor_up']),
        header_row("導師(下)", lambda n: pgy_info[n]['mentor_down']),
    ]

    for day in sorted(schedule_output.keys()):
        row = [text_cell(f"{year}/{month}/{day}"), text_cell(day_to_weekday.get(day, ""))]
        for name in pgy_names_ordered:
            info = schedule_output[day].get(name, {'text': '', 'color': 'normal'})
            if info['color'] == 'raw':
                rgb = info.get('rgb')
                rgb = None if rgb == (1, 1, 1) else rgb  # 原本白底就不特別上色
            else:
                rgb = OUTPUT_COLOR_RGB.get(info['color'])
            row.append(colored_cell(info['text'], rgb))
        row.append(text_cell(day_to_remarks.get(day, "")))
        rows.append({"values": row})

    sheets_service.spreadsheets().batchUpdate(
        spreadsheetId=spreadsheet_id,
        body={"requests": [{
            "updateCells": {
                "rows": rows,
                "fields": "userEnteredValue,userEnteredFormat.backgroundColor",
                "start": {"sheetId": sheet_id, "rowIndex": 0, "columnIndex": 0}
            }
        }]}
    ).execute()

    url = f"https://docs.google.com/spreadsheets/d/{spreadsheet_id}/edit"
    print(f"完成！新表格連結：{url}")
    return url


output_url = build_output_spreadsheet()
