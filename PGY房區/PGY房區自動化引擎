# ---------------------------------------------------------
# Cell 8：共用判斷函式
# ---------------------------------------------------------
def is_hard_excluded(label, keywords):
    return any(kw in label for kw in keywords)


def mentor_conflict(pgy_name, attending_name):
    mentors = {pgy_info[pgy_name]['mentor_up'], pgy_info[pgy_name]['mentor_down']}
    for a, b in MENTOR_CONFLICT_PAIRS:
        if (a in mentors and attending_name == b) or (b in mentors and attending_name == a):
            return True
    return False


# ---------------------------------------------------------
# Cell 9：主排班引擎
# ---------------------------------------------------------
def generate_schedule():
    random.seed(RANDOM_SEED)

    days_sorted = sorted(attending_data['daily'].keys())
    first_day, last_day = min(days_sorted), max(days_sorted)
    pgy_fixed_order = list(pgy_info.keys())  # 麻評門診固定依此左到右順序輪流

    clinic_done = {name: False for name in pgy_info}
    ward_eval_count = {name: 0 for name in pgy_info}
    mentor_met_early = {name: False for name in pgy_info}   # 前兩週是否已遇過任一導師
    mentor_meet_total = {name: 0 for name in pgy_info}

    # 假日判斷：PGY表格裡當天所有人的儲存格都是灰色，就算假日
    holiday_days = {row['day'] for row in pgy_daily_rows
                    if row['cells'] and all(classify_color(c['rgb']) == 'holiday_gray' for c in row['cells'].values())}

    def mark_mentor_meeting(name, att_name, day):
        if att_name in (pgy_info[name]['mentor_up'], pgy_info[name]['mentor_down']):
            mentor_meet_total[name] += 1
            if day - first_day < 14:
                mentor_met_early[name] = True

    output = {}  # output[day][pgy_name] = {'text':.., 'color':label}

    for day in days_sorted:
        output[day] = {}
        used_attendings = set()  # 今天已被配走的醫師(不分台北/淡水)，避免同一人配給兩位PGY
        att_today = attending_data['daily'][day]
        pgy_row = next((r for r in pgy_daily_rows if r['day'] == day), None)
        is_pca_day = (day == first_day)
        is_last_day = (day == last_day)

        def pick_color(name, ward_eval_pgy):
            if name == ward_eval_pgy:
                return 'ward_eval'
            return 'pca' if is_pca_day else 'normal'

        # -- 判斷每位PGY今天的預先狀態(休假/淡水/一般) --
        vacation_today, danshui_today, pending_today = set(), set(), set()
        for name in pgy_info:
            existing = pgy_row['cells'][name] if pgy_row else {'text': '', 'rgb': (1, 1, 1)}
            status = classify_color(existing['rgb'])
            if existing['text'].strip() == '休假' or status in ('holiday_gray', 'personal_vacation'):
                vacation_today.add(name)
            elif status == 'danshui_marked':
                danshui_today.add(name)
            else:
                pending_today.add(name)

        # -- 休假：原封不動照抄原本的文字跟顏色 --
        for name in vacation_today:
            existing = pgy_row['cells'][name] if pgy_row else {'text': '', 'rgb': (1, 1, 1)}
            output[day][name] = {'text': existing['text'], 'color': 'raw', 'rgb': existing['rgb']}

        # -- 淡水指定日：找淡水可用醫師 --
        for name in danshui_today:
            candidates = list({
                dn for label, dn in att_today['danshui'].items()
                if not is_hard_excluded(label, DANSHUI_HARD_EXCLUDE_KEYWORDS)
                and not mentor_conflict(name, dn) and dn not in used_attendings
            })
            if candidates:
                chosen = random.choice(candidates)
                used_attendings.add(chosen)
                output[day][name] = {'text': chosen, 'color': 'danshui'}
                mark_mentor_meeting(name, chosen, day)
            else:
                output[day][name] = {'text': '', 'color': 'danshui'}
                print(f"[警告] {day}日 {name} 淡水指定日找不到可用醫師(可能都被導師互斥規則排除或都被同天其他人選走)，請手動確認")

        need_room_pool = set(pending_today)  # 今天需要台北房區的人
        ward_eval_pgy = None

        if not is_pca_day and not is_last_day:
            # 麻評門診：固定依左到右欄位順序輪流，跟任何次數無關
            clinic_candidates = [n for n in pgy_fixed_order if n in need_room_pool and not clinic_done[n]]
            if clinic_candidates:
                clinic_pgy = clinic_candidates[0]
                clinic_done[clinic_pgy] = True
                output[day][clinic_pgy] = {'text': '麻評門診', 'color': 'clinic'}
                need_room_pool.discard(clinic_pgy)

            # 病房評估：已排過門診、次數<3、不是假日後第一個工作天
            is_day_after_holiday = (day - 1) in holiday_days
            if not is_day_after_holiday:
                ward_candidates = [n for n in need_room_pool if clinic_done[n] and ward_eval_count[n] < 3]
                if ward_candidates:
                    pgy2_names = [n for n in ward_candidates if pgy_info[n]['level'] == 'PGY2']
                    if any(ward_eval_count[n] < 2 for n in ward_candidates):
                        pool, reason = [n for n in ward_candidates if ward_eval_count[n] < 2], "有人未滿2次，優先未滿2次者"
                    elif pgy2_names:
                        pool, reason = pgy2_names, "大家都滿2次了，優先PGY2"
                    else:
                        pool, reason = ward_candidates, "大家都滿2次、且今天沒有PGY2符合資格，只好從剩下的人選"
                    min_count = min(ward_eval_count[n] for n in pool)
                    tied = [n for n in pool if ward_eval_count[n] == min_count]
                    ward_eval_pgy = random.choice(tied)
                    if DEBUG_WARD_EVAL:
                        print(f"[病房評估決策] {day}日：候選={[(n, pgy_info[n]['level'], ward_eval_count[n]) for n in ward_candidates]}  "
                              f"篩選邏輯={reason}  平手者={tied}  最終選中={ward_eval_pgy}")
                    ward_eval_count[ward_eval_pgy] += 1
                    # 病房評估的人仍留在 need_room_pool，稍後照樣配房區

        # -- 台北房區配對：先以「醫師姓名」為單位去重，排除今天已被淡水/其他人用掉的醫師 --
        taipei_attending_pool = {}
        for label, att_name in att_today['taipei'].items():
            if not is_hard_excluded(label, TAIPEI_HARD_EXCLUDE_KEYWORDS) and att_name not in used_attendings:
                taipei_attending_pool.setdefault(att_name, label)
        available_rooms = {label: name for name, label in taipei_attending_pool.items()}

        remaining_pgy = list(need_room_pool)
        random.shuffle(remaining_pgy)
        remaining_pgy.sort(key=lambda n: mentor_met_early[n])  # 未在前兩週遇過導師的人優先處理

        # 第一輪：導師優先
        assigned_labels, still_unassigned = set(), []
        for name in remaining_pgy:
            mentors = {pgy_info[name]['mentor_up'], pgy_info[name]['mentor_down']}
            found_label = next((l for l, a in available_rooms.items() if l not in assigned_labels and a in mentors), None)
            if found_label:
                att_name = available_rooms[found_label]
                assigned_labels.add(found_label)
                used_attendings.add(att_name)
                output[day][name] = {'text': att_name, 'color': pick_color(name, ward_eval_pgy)}
                mark_mentor_meeting(name, att_name, day)
            else:
                still_unassigned.append(name)

        # 第二輪：剩下隨機配對，並檢查導師互斥
        free_labels = [l for l in available_rooms if l not in assigned_labels]
        random.shuffle(free_labels)
        for name in still_unassigned:
            chosen_label = next((l for l in free_labels if not mentor_conflict(name, available_rooms[l])), None)
            if chosen_label:
                free_labels.remove(chosen_label)
                att_name = available_rooms[chosen_label]
                used_attendings.add(att_name)
                output[day][name] = {'text': att_name, 'color': pick_color(name, ward_eval_pgy)}
            else:
                output[day][name] = {'text': '', 'color': 'unassigned'}
                print(f"[警告] {day}日 {name} 找不到可配對的房區(可能房區數不夠或都導師互斥)，請手動確認")

    return output, clinic_done, ward_eval_count, mentor_meet_total


schedule_output, clinic_done, ward_eval_count, mentor_meet_total = generate_schedule()

print("\n=== 統計結果 ===")
for name in pgy_info:
    print(f"{name}: 麻評門診已排={clinic_done[name]}, 病房評估次數={ward_eval_count[name]}, 導師碰面次數={mentor_meet_total[name]}")


