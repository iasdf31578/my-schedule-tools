def extract_name(text):
    """'楊承憲1-4' → '楊承憲'"""
    m = re.match(r'[一-鿿]+', text.strip())
    return m.group(0) if m else text.strip()


def parse_attending_sheet(grid, max_cols):
    """第2列=標題；C欄起到"台北白班"(含)=台北，其後兩欄日期鏡像(跳過)，再來=淡水"""
    labels, taipei_cols, danshui_cols = {}, [], []
    seen_baiban, skip = False, 0
    for c in range(3, max_cols + 1):
        text = cell(grid, 2, c)['text'].strip()
        if seen_baiban and skip > 0:
            skip -= 1
            continue
        if not text:
            continue
        labels[c] = text
        if not seen_baiban:
            taipei_cols.append(c)
            if text == "台北白班":
                seen_baiban, skip = True, 2
        else:
            danshui_cols.append(c)
    daily = {}
    for r in range(3, len(grid) + 1):
        day_text = cell(grid, r, 1)['text'].strip()
        if day_text.isdigit():
            daily[int(day_text)] = {
                'taipei': {labels[c]: extract_name(cell(grid, r, c)['text'])
                           for c in taipei_cols if cell(grid, r, c)['text'].strip()},
                'danshui': {labels[c]: extract_name(cell(grid, r, c)['text'])
                            for c in danshui_cols if cell(grid, r, c)['text'].strip()},
            }
    return {'taipei_cols': taipei_cols, 'danshui_cols': danshui_cols, 'labels': labels, 'daily': daily}


def parse_pgy_sheet(grid, max_cols):
    pgy_cols, remarks_col = [], None
    for c in range(3, max_cols + 1):
        h = cell(grid, 1, c)['text'].strip()
        if h == "備註":
            remarks_col = c
        elif h:
            pgy_cols.append(c)
    pgy_info = {}
    for c in pgy_cols:
        name = cell(grid, 3, c)['text'].strip()
        if name:
            pgy_info[name] = {'col': c, 'level': cell(grid, 1, c)['text'].strip(),
                              'empid': cell(grid, 2, c)['text'].strip(),
                              'mentor_up': cell(grid, 4, c)['text'].strip(),
                              'mentor_down': cell(grid, 5, c)['text'].strip()}
    daily_rows = []
    for r in range(6, len(grid) + 1):
        m = re.match(r'(\d{4})/(\d{1,2})/(\d{1,2})', cell(grid, r, 1)['text'].strip())
        if m:
            daily_rows.append({
                'day': int(m.group(3)),
                'weekday': cell(grid, r, 2)['text'].strip(),
                'remarks': cell(grid, r, remarks_col)['text'].strip() if remarks_col else '',
                'cells': {n: cell(grid, r, i['col']) for n, i in pgy_info.items()},
            })
    return pgy_info, daily_rows


def matched_keyword(label, keywords):
    for kw in keywords:
        if (kw.startswith('=') and label.strip() == kw[1:]) or (not kw.startswith('=') and kw in label):
            return kw
    return None


def generate_schedule(attending, pgy_info, pgy_daily_rows, national_holidays):
    rng = random.Random(RANDOM_SEED)
    year, month = target_year_month()
    mentors_of = lambda n: {pgy_info[n]['mentor_up'], pgy_info[n]['mentor_down']}
    is_pgy2 = lambda n: pgy_info[n]['level'].upper().replace(' ', '').startswith('PGY2')

    def conflict(n, att):
        ms = mentors_of(n)
        return any((a in ms and att == b) or (b in ms and att == a) for a, b in MENTOR_CONFLICT_PAIRS)

    days_sorted = sorted(attending['daily'])
    first_day = days_sorted[0]
    order = list(pgy_info)

    # 假日 = 週末 ＋ 平日國定假日 ＋ 當天過半格子是灰色
    holiday_days = {d for d in days_sorted if is_weekend(year, month, d)} | set(national_holidays)
    for row in pgy_daily_rows:
        cs = list(row['cells'].values())
        if cs and sum(classify_color(c['rgb']) == 'holiday_gray' for c in cs) * 2 > len(cs):
            holiday_days.add(row['day'])
    working = [d for d in days_sorted if d not in holiday_days]
    pca_day = working[0] if working else None
    last_working = working[-1] if working else None

    clinic_done = {n: False for n in order}
    ward_count = {n: 0 for n in order}
    met_early = {n: False for n in order}
    meet_total = {n: 0 for n in order}
    warnings = []

    def meet(n, att, day):
        if att in mentors_of(n):
            meet_total[n] += 1
            if day - first_day < 14:
                met_early[n] = True

    output = {}
    for day in days_sorted:
        out = output[day] = {}
        used = set()
        att = attending['daily'][day]
        row = next((r for r in pgy_daily_rows if r['day'] == day), None)
        special_ok = day not in holiday_days and day not in (pca_day, last_working)

        vacation, danshui, pending = [], [], []
        for n in order:
            ex = row['cells'][n] if row else {'text': '', 'rgb': (1, 1, 1)}
            st = classify_color(ex['rgb'])
            if ex['text'].strip() in ('休假', '特休') or st in ('holiday_gray', 'personal_vacation'):
                vacation.append(n)
                out[n] = {'text': ex['text'], 'color': 'raw', 'rgb': ex['rgb']}
            elif st == 'danshui_marked':
                danshui.append(n)
            else:
                pending.append(n)

        for n in danshui:
            cands = sorted({dn for label, dn in att['danshui'].items()
                            if not matched_keyword(label, DANSHUI_HARD_EXCLUDE_KEYWORDS)
                            and not conflict(n, dn) and dn not in used})
            if cands:
                ch = rng.choice(cands)
                used.add(ch)
                out[n] = {'text': ch, 'color': 'danshui'}
                meet(n, ch, day)
            else:
                out[n] = {'text': '', 'color': 'unassigned'}
                warnings.append(f"{month}/{day} {n}（淡水無可用醫師）")

        need = list(pending)
        if special_ok:  # 麻評門診：左到右輪流，每人一次
            c = next((n for n in need if not clinic_done[n]), None)
            if c:
                clinic_done[c] = True
                out[c] = {'text': '麻評門診', 'color': 'clinic'}
                need.remove(c)

        pool = {}
        for label, an in att['taipei'].items():
            if not matched_keyword(label, TAIPEI_HARD_EXCLUDE_KEYWORDS) and an not in used:
                pool.setdefault(an, label)
        rooms = {label: an for an, label in pool.items()}

        rng.shuffle(need)
        need.sort(key=lambda n: met_early[n])  # 前兩週沒遇過導師的人優先
        assigned, taken, left = {}, set(), []
        for n in need:  # 第一輪：導師
            f = next((l for l, a in rooms.items()
                      if l not in taken and a in mentors_of(n) and not conflict(n, a)), None)
            if f:
                taken.add(f)
                assigned[n] = rooms[f]
            else:
                left.append(n)
        free = [l for l in rooms if l not in taken]
        rng.shuffle(free)
        for n in left:  # 第二輪：隨機
            ch = next((l for l in free if not conflict(n, rooms[l])), None)
            if ch:
                free.remove(ch)
                assigned[n] = rooms[ch]
            else:
                out[n] = {'text': '', 'color': 'unassigned'}
                warnings.append(f"{month}/{day} {n}（台北房區不足或導師互斥）")

        ward = None  # 病房評估：只從今天有配到台北房區的人選
        if special_ok and (day - 1) not in holiday_days:
            cands = [n for n in order if n in assigned and clinic_done[n] and ward_count[n] < 3]
            if cands:
                under2 = [n for n in cands if ward_count[n] < 2]
                pgy2s = [n for n in cands if is_pgy2(n)]
                pool_w = under2 or pgy2s or cands
                low = min(ward_count[n] for n in pool_w)
                tied = [n for n in pool_w if ward_count[n] == low]
                ward = rng.choice(tied)
                ward_count[ward] += 1
                if DEBUG_WARD_EVAL:
                    print(f"[病房評估] {day}日 候選={[(n, ward_count[n]) for n in cands]} 平手={tied} 選中={ward}")

        for n, an in assigned.items():
            out[n] = {'text': an, 'color': 'ward_eval' if n == ward else ('pca' if day == pca_day else 'normal')}
            meet(n, an, day)

    return output, clinic_done, ward_count, meet_total, warnings


def build_result_rows(output, pgy_info, pgy_daily_rows):
    year, month = target_year_month()
    names = list(pgy_info)
    wk = {r['day']: r['weekday'] for r in pgy_daily_rows}
    rm = {r['day']: r['remarks'] for r in pgy_daily_rows}

    def header(col_b, func):
        return {"values": [text_cell(''), text_cell(col_b)] + [text_cell(func(n)) for n in names] + [text_cell('')]}

    rows = [
        {"values": [text_cell(f"{month}月 PGY房區表"), text_cell("職級")]
                   + [text_cell(pgy_info[n]['level']) for n in names] + [text_cell("備註")]},
        header("員編", lambda n: pgy_info[n]['empid']),
        header("姓名", lambda n: n),
        header("導師(上半月)", lambda n: pgy_info[n]['mentor_up']),
        header("導師(下半月)", lambda n: pgy_info[n]['mentor_down']),
    ]
    for day in sorted(output):
        r = [text_cell(f"{year}/{month}/{day}"), text_cell(wk.get(day, weekday_zh(year, month, day)))]
        for n in names:
            info = output[day].get(n, {'text': '', 'color': 'normal'})
            if info['color'] == 'raw':
                rgb = None if info.get('rgb') == (1, 1, 1) else info.get('rgb')
            else:
                rgb = OUTPUT_COLOR_RGB.get(info['color'])
            r.append(colored_cell(info['text'], rgb))
        r.append(text_cell(rm.get(day, '')))
        rows.append({"values": r})
    return rows


def run_schedule(sheet_id_ss, national_holidays):
    attending_grid = read_sheet_grid(ATTENDING_SHEET_ID, TARGET_TAB, ATTENDING_MAX_ROWS, ATTENDING_MAX_COLS)
    attending = parse_attending_sheet(attending_grid, ATTENDING_MAX_COLS)
    pgy_info, pgy_daily_rows = parse_pgy_sheet(
        read_sheet_grid(sheet_id_ss, TARGET_TAB, PGY_MAX_ROWS, PGY_MAX_COLS), PGY_MAX_COLS)

    for title, cols, kws in (("台北", attending['taipei_cols'], TAIPEI_HARD_EXCLUDE_KEYWORDS),
                             ("淡水", attending['danshui_cols'], DANSHUI_HARD_EXCLUDE_KEYWORDS)):
        excluded = [attending['labels'][c] for c in cols if matched_keyword(attending['labels'][c], kws)]
        print(f"{title}房區排除：{'、'.join(excluded) or '無'}")

    output, clinic_done, ward_count, meet_total, warnings = generate_schedule(
        attending, pgy_info, pgy_daily_rows, national_holidays)

    write_rows(sheet_id_ss, list_tabs(sheet_id_ss)[TARGET_TAB], build_result_rows(output, pgy_info, pgy_daily_rows))

    print("\n姓名　麻評門診　病房評估　遇到導師")
    for n in pgy_info:
        print(f"{n}　{'✓' if clinic_done[n] else '✗'}　{ward_count[n]}次　{meet_total[n]}次")
    if warnings:
        print("\n⚠ 需手動處理（紅色格）：" + "；".join(warnings))


