def _v(values, r, c):
    return values[r][c].strip() if 0 <= r < len(values) and 0 <= c < len(values[r]) else ''


def find_pgy_block(values):
    """A欄找到 'PGY' 標題列往下讀到空白列；欄位依標題判斷(標題可能在上一列)，找不到用預設位置"""
    start = next((r for r in range(len(values)) if _v(values, r, 0) == 'PGY'), None)
    if start is None:
        raise ValueError("CR排課A欄找不到 'PGY'")
    col = {'empid': 0, 'name': 1, 'level': 2, 'mentor_up': 3, 'mentor_down': 4, 'vacation': 5}
    for r in (start - 1, start):
        if r < 0:
            continue
        for c in range(len(values[r])):
            t = _v(values, r, c)
            if t == '姓名':
                col['name'] = c
            elif t in ('級別', '職級'):
                col['level'] = c
            elif t.startswith('導師') and '上' in t:
                col['mentor_up'] = c
            elif t.startswith('導師') and '下' in t:
                col['mentor_down'] = c
            elif t in ('特休', '休假', '特休日期'):
                col['vacation'] = c
    pgys = []
    for r in range(start + 1, len(values)):
        if not _v(values, r, col['name']):
            break
        pgys.append({k: _v(values, r, c) for k, c in col.items()})
    if not pgys:
        raise ValueError("CR排課 'PGY' 標題下沒有資料")
    return pgys


_DATE_TOKEN = re.compile(
    r'(?:(\d{1,2})\s*/\s*)?(\d{1,2})(?:\s*[-~～至]\s*(?:(\d{1,2})\s*/\s*)?(\d{1,2}))?')


def parse_vacation_days(text, year, month):
    """特休文字 → (本月日期set, 略過的片段)。支援 10/19、10/21、10/16-17、3/27. 28、7.14、11/21(公假) 等"""
    if not text:
        return set(), []
    t = re.sub(r'\d{4}\s*[/\-.]\s*', '', text)
    t = re.sub(r'[（(][^）)]*[)）]', ' ', t)
    days, skipped, cur_month = set(), [], month
    for m in _DATE_TOKEN.finditer(t):
        m1, d1, m2, d2 = m.groups()
        if m1:
            cur_month = int(m1)
        try:
            start = datetime.date(year, cur_month, int(d1))
            if d2:
                end_month = int(m2) if m2 else cur_month
                end = datetime.date(year, end_month, int(d2))
                cur_month = end_month
            else:
                end = start
        except ValueError:
            skipped.append(m.group(0))
            continue
        d = start
        while d <= end:
            if d.month == month:
                days.add(d.day)
            else:
                skipped.append(f"{d.month}/{d.day}")
            d += datetime.timedelta(days=1)
    return days, skipped


_HOLIDAY_PATTERN = re.compile(r'假|除夕|初[一二三四五六]|元旦')


def detect_holidays_from_cr(values, year, month):
    """CR月曆「北/淡」列中平日寫著放假/補假等 → {日: 說明}"""
    n_days = calendar.monthrange(year, month)[1]
    found = {}
    for r in range(1, len(values)):
        if _v(values, r, 0) != '北':
            continue
        for c in range(1, 7):
            dt = _v(values, r - 1, c)
            if not dt.isdigit():
                continue
            day = int(dt)
            if not 1 <= day <= n_days or is_weekend(year, month, day):
                continue
            for rr in (r, r + 1):
                if _v(values, rr, 0) in ('北', '淡') and _HOLIDAY_PATTERN.search(_v(values, rr, c)):
                    found[day] = _v(values, rr, c).split('\n')[0].strip()
                    break
    return found


def ask_national_holidays(suggested, year, month):
    if NATIONAL_HOLIDAYS is not None:
        days = sorted(set(NATIONAL_HOLIDAYS))
    else:
        if suggested:
            print("偵測到平日國定假日：" + "、".join(f"{month}/{d} {t}" for d, t in sorted(suggested.items())))
            ans = input("Enter 採用，或輸入日期(如 9,26)，沒有輸入 0：").strip()
        else:
            ans = input("平日國定假日(如 9,26)，沒有直接 Enter：").strip()
        if not ans:
            days = sorted(suggested)
        elif ans == '0':
            days = []
        else:
            days = sorted({int(x) for x in re.findall(r'\d+', ans)})
    n_days = calendar.monthrange(year, month)[1]
    if any(not 1 <= d <= n_days for d in days):
        raise ValueError(f"日期超出本月範圍：{days}")
    return days, {d: suggested.get(d, '國定假日') for d in days}


def level_rank(level):
    lv = level.upper().replace(' ', '')
    return 0 if lv.startswith('PGY1') else 1 if lv.startswith('PGY2') else 2


def danshui_week_days(year, month, holidays):
    """(前半部淡水日, 後半部淡水日)，只含本月工作天"""
    n_days = calendar.monthrange(year, month)[1]
    working = [d for d in range(1, n_days + 1) if d not in holidays]
    if not working:
        return set(), set()
    last = datetime.date(year, month, working[-1])
    if DANSHUI_WEEK_MODE == "rolling":
        back_start = last - datetime.timedelta(days=7)
    else:
        back_start = last - datetime.timedelta(days=last.weekday() + 7)
    front_start = back_start - datetime.timedelta(days=7)

    def week(start):
        days = (start + datetime.timedelta(days=i) for i in range(7))
        return {d.day for d in days if d.month == month and d.year == year and d.day not in holidays}

    return week(front_start), week(back_start)


def build_initial_rows(pgys, year, month, national_holidays, holiday_names):
    """第1列 職級(最右「備註」)、第2列 員編、第3列 姓名、第4/5列 導師上/下半月；第6列起 A日期 B星期 C起各PGY"""
    n_days = calendar.monthrange(year, month)[1]
    fmt = lambda ds: '、'.join(f"{month}/{d}" for d in sorted(ds)) or '無'
    ordered = sorted(pgys, key=lambda p: level_rank(p['level']))
    holidays = {d for d in range(1, n_days + 1) if is_weekend(year, month, d)} | set(national_holidays)

    vac = {}
    print("\n特休：")
    for p in ordered:
        days, skipped = parse_vacation_days(p['vacation'], year, month)
        vac[p['name']] = days - holidays
        print(f"  {p['level']} {p['name']}：{fmt(days)}" + (f"  ⚠ 無法辨識：{skipped}" if skipped else ''))

    danshui = {p['name']: set() for p in ordered}
    if DANSHUI_AUTO:
        front_days, back_days = danshui_week_days(year, month, holidays)
        half = (len(ordered) + 1) // 2
        for i, p in enumerate(ordered):
            danshui[p['name']] = set(front_days if i < half else back_days)
        print("淡水：")
        print(f"  {'、'.join(p['name'] for p in ordered[:half])}：{fmt(front_days)}")
        print(f"  {'、'.join(p['name'] for p in ordered[half:])}：{fmt(back_days)}")

    def header(col_b, func):
        return {"values": [text_cell(''), text_cell(col_b)] + [text_cell(func(p)) for p in ordered] + [text_cell('')]}

    rows = [
        {"values": [text_cell(f"{month}月 PGY房區表"), text_cell("職級")]
                   + [text_cell(p['level']) for p in ordered] + [text_cell("備註")]},
        header("員編", lambda p: p['empid']),
        header("姓名", lambda p: p['name']),
        header("導師(上半月)", lambda p: p['mentor_up']),
        header("導師(下半月)", lambda p: p['mentor_down']),
    ]
    for d in range(1, n_days + 1):
        r = [text_cell(f"{year}/{month}/{d}"), text_cell(weekday_zh(year, month, d))]
        for p in ordered:
            if d in holidays:
                r.append(colored_cell('', GRAY))
            elif d in vac[p['name']]:
                r.append(colored_cell('特休', YELLOW))
            elif d in danshui[p['name']]:
                r.append(colored_cell('淡水', LIGHT_BLUE))
            else:
                r.append(text_cell(''))
        r.append(text_cell(holiday_names.get(d, '') if d in national_holidays else ''))
        rows.append({"values": r})
    return rows


def create_initial_sheet():
    """回傳 (新試算表ID, 平日國定假日list)"""
    year, month = target_year_month()
    if TARGET_TAB not in list_tabs(CR_SHEET_ID):
        raise ValueError(f"CR排課沒有「{TARGET_TAB}」分頁")
    cr_values = read_values(CR_SHEET_ID, TARGET_TAB)
    pgys = find_pgy_block(cr_values)
    holidays, names = ask_national_holidays(detect_holidays_from_cr(cr_values, year, month), year, month)
    rows = build_initial_rows(pgys, year, month, holidays, names)

    new_ss = sheets_service.spreadsheets().create(body={
        "properties": {"title": f"{TARGET_TAB} PGY房區表"},
        "sheets": [{"properties": {"title": TARGET_TAB,
                                   "gridProperties": {"frozenRowCount": 5, "frozenColumnCount": 2}}}]
    }).execute()
    write_rows(new_ss['spreadsheetId'], new_ss['sheets'][0]['properties']['sheetId'], rows)
    return new_ss['spreadsheetId'], holidays


