# ---------------------------------------------------------
# Cell 3：欄位字母 <-> 數字 轉換
# ---------------------------------------------------------
def col_num_to_letter(n):
    letters = ""
    while n > 0:
        n, rem = divmod(n - 1, 26)
        letters = chr(65 + rem) + letters
    return letters


# ---------------------------------------------------------
# Cell 4：通用讀取（文字＋底色）與共用小工具
# ---------------------------------------------------------
def read_sheet_grid(spreadsheet_id, sheet_name, max_rows, max_cols):
    """回傳 2D list，grid[r][c] = {'text': str, 'rgb': (r,g,b)}，索引從0開始"""
    col_letter = col_num_to_letter(max_cols)
    rng = f"'{sheet_name}'!A1:{col_letter}{max_rows}"
    result = sheets_service.spreadsheets().get(
        spreadsheetId=spreadsheet_id,
        ranges=[rng],
        fields="sheets.data.rowData.values(formattedValue,userEnteredFormat.backgroundColor)"
    ).execute()

    row_data = result['sheets'][0]['data'][0].get('rowData', [])
    grid = []
    for row in row_data:
        row_out = []
        for c in row.get('values', []):
            bg = c.get('userEnteredFormat', {}).get('backgroundColor')
            if bg is not None:
                # 注意：Sheets API 對數值為0的顏色分量會直接省略該欄位(不是回傳0)，
                # 缺欄位要當作0，不能預設成1，否則會把「省略=0」誤判成白色
                rgb = (round(bg.get('red', 0), 3), round(bg.get('green', 0), 3), round(bg.get('blue', 0), 3))
            else:
                rgb = (1, 1, 1)
            row_out.append({'text': c.get('formattedValue', '') or '', 'rgb': rgb})
        grid.append(row_out)
    return grid


def classify_color(rgb):
    for known, label in COLOR_MEANING.items():
        if all(abs(a - b) < COLOR_TOLERANCE for a, b in zip(rgb, known)):
            return label
    return None


def extract_name(text):
    """主治醫師欄位常是「姓名+房號」(如 '楊承憲1-4')，只取最前面連續的中文字元。"""
    m = re.match(r'[\u4e00-\u9fff]+', text.strip())
    return m.group(0) if m else text.strip()


def cell(grid, row, col):
    """1-indexed 存取，超出範圍回傳空白cell"""
    if row - 1 < len(grid) and col - 1 < len(grid[row - 1]):
        return grid[row - 1][col - 1]
    return {'text': '', 'rgb': (1, 1, 1)}


# ---------------------------------------------------------
# Cell 5：解析主治醫師房區表
# 第2列=各欄標題，第3列起=逐日資料。A欄=日期，C欄起~"台北白班"(含)=台北房區，
# 其後兩欄是日期鏡像欄(跳過)，再來才是淡水房區。
# ---------------------------------------------------------
def parse_attending_sheet(grid, max_cols):
    header_row = 2
    labels = {}
    taipei_cols, danshui_cols = [], []
    seen_taipei_baiban = False
    skip_mirror = 0
    for c in range(3, max_cols + 1):
        text = cell(grid, header_row, c)['text'].strip()
        if seen_taipei_baiban and skip_mirror > 0:
            skip_mirror -= 1
            continue
        if not text:
            continue
        labels[c] = text
        if not seen_taipei_baiban:
            taipei_cols.append(c)
            if text == "台北白班":
                seen_taipei_baiban = True
                skip_mirror = 2  # 接下來兩欄是日期鏡像欄，不是淡水房區
        else:
            danshui_cols.append(c)

    daily = {}
    for r in range(3, len(grid) + 1):
        day_text = cell(grid, r, 1)['text'].strip()
        if not day_text.isdigit():
            continue
        day_num = int(day_text)
        taipei_map = {labels[c]: extract_name(cell(grid, r, c)['text'])
                      for c in taipei_cols if cell(grid, r, c)['text'].strip()}
        danshui_map = {labels[c]: extract_name(cell(grid, r, c)['text'])
                       for c in danshui_cols if cell(grid, r, c)['text'].strip()}
        daily[day_num] = {'taipei': taipei_map, 'danshui': danshui_map}

    return {'taipei_cols': taipei_cols, 'danshui_cols': danshui_cols, 'labels': labels, 'daily': daily}


# ---------------------------------------------------------
# Cell 6：解析PGY房區表
# 第1列=職級, 第2列=員編, 第3列=姓名, 第4列=導師(上), 第5列=導師(下)
# 第6列起：A欄=日期, B欄=星期, C欄起=各PGY當天內容, 標題為"備註"的欄位=remarks
# ---------------------------------------------------------
def parse_pgy_sheet(grid, max_cols):
    pgy_cols, remarks_col = [], None
    for c in range(3, max_cols + 1):
        header1 = cell(grid, 1, c)['text'].strip()
        if header1 == "備註":
            remarks_col = c
        elif header1:
            pgy_cols.append(c)

    pgy_info = {}
    for c in pgy_cols:
        name = cell(grid, 3, c)['text'].strip()
        if name:
            pgy_info[name] = {
                'col': c,
                'level': cell(grid, 1, c)['text'].strip(),
                'empid': cell(grid, 2, c)['text'].strip(),
                'mentor_up': cell(grid, 4, c)['text'].strip(),
                'mentor_down': cell(grid, 5, c)['text'].strip(),
            }

    daily_rows = []
    for r in range(6, len(grid) + 1):
        m = re.match(r'(\d{4})/(\d{1,2})/(\d{1,2})', cell(grid, r, 1)['text'].strip())
        if not m:
            continue
        daily_rows.append({
            'day': int(m.group(3)),
            'weekday': cell(grid, r, 2)['text'].strip(),
            'remarks': cell(grid, r, remarks_col)['text'].strip() if remarks_col else '',
            'cells': {name: cell(grid, r, info['col']) for name, info in pgy_info.items()},
        })

    return pgy_info, daily_rows


