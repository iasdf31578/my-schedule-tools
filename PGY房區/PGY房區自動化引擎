WEEKDAY_ZH = "一二三四五六日"


def target_year_month():
    return int(TARGET_TAB[:4]), int(TARGET_TAB[4:])


def is_weekend(year, month, day):
    return datetime.date(year, month, day).weekday() >= 5


def weekday_zh(year, month, day):
    return WEEKDAY_ZH[datetime.date(year, month, day).weekday()]


def col_num_to_letter(n):
    letters = ""
    while n > 0:
        n, rem = divmod(n - 1, 26)
        letters = chr(65 + rem) + letters
    return letters


def sheet_url(spreadsheet_id):
    return f"https://docs.google.com/spreadsheets/d/{spreadsheet_id}/edit"


def list_tabs(spreadsheet_id):
    meta = sheets_service.spreadsheets().get(spreadsheetId=spreadsheet_id, fields="sheets.properties").execute()
    return {s['properties']['title']: s['properties']['sheetId'] for s in meta['sheets']}


def read_values(spreadsheet_id, sheet_name, max_rows=250, max_cols=26):
    rng = f"'{sheet_name}'!A1:{col_num_to_letter(max_cols)}{max_rows}"
    rows = sheets_service.spreadsheets().values().get(
        spreadsheetId=spreadsheet_id, range=rng).execute().get('values', [])
    return [[str(x) for x in r] + [''] * (max_cols - len(r)) for r in rows]


def read_sheet_grid(spreadsheet_id, sheet_name, max_rows, max_cols):
    """grid[r][c] = {'text': str, 'rgb': (r,g,b)}，索引從0開始"""
    rng = f"'{sheet_name}'!A1:{col_num_to_letter(max_cols)}{max_rows}"
    result = sheets_service.spreadsheets().get(
        spreadsheetId=spreadsheet_id, ranges=[rng],
        fields="sheets.data.rowData.values(formattedValue,userEnteredFormat.backgroundColor)").execute()
    grid = []
    for row in result['sheets'][0]['data'][0].get('rowData', []):
        row_out = []
        for c in row.get('values', []):
            bg = c.get('userEnteredFormat', {}).get('backgroundColor')
            # Sheets API 對值為0的顏色分量會省略，缺的要當0
            rgb = (round(bg.get('red', 0), 3), round(bg.get('green', 0), 3), round(bg.get('blue', 0), 3)) \
                if bg is not None else (1, 1, 1)
            row_out.append({'text': c.get('formattedValue', '') or '', 'rgb': rgb})
        grid.append(row_out)
    return grid


def classify_color(rgb):
    for known, label in COLOR_MEANING.items():
        if all(abs(a - b) < COLOR_TOLERANCE for a, b in zip(rgb, known)):
            return label
    return None


def cell(grid, row, col):
    """1-indexed，超出範圍回傳空白"""
    if row - 1 < len(grid) and col - 1 < len(grid[row - 1]):
        return grid[row - 1][col - 1]
    return {'text': '', 'rgb': (1, 1, 1)}


def text_cell(value):
    return {"userEnteredValue": {"stringValue": value}}


def colored_cell(value, rgb):
    c = text_cell(value)
    if rgb is not None:
        r, g, b = rgb
        c["userEnteredFormat"] = {"backgroundColor": {"red": r, "green": g, "blue": b}}
    return c


def write_rows(spreadsheet_id, sheet_id, rows):
    """整張表覆寫(文字＋底色)"""
    sheets_service.spreadsheets().batchUpdate(
        spreadsheetId=spreadsheet_id,
        body={"requests": [{"updateCells": {
            "rows": rows,
            "fields": "userEnteredValue,userEnteredFormat.backgroundColor",
            "start": {"sheetId": sheet_id, "rowIndex": 0, "columnIndex": 0}}}]}).execute()


